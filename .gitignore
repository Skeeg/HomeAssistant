known_devices.yaml
phue.conf
plex.conf
pyozw.sqlite
secrets.yaml
tradfri.conf
webostv.conf

# Temporary files
*.db-journal
*.pid
tts

# automatically downloaded dependencies
deps
lib

# Log files
home-assistant.log
home-assistant.log.*
ozw_log.txt

# Development files
custom_components

# End of https://www.toptal.com/developers/gitignore/api/homeassistant

# Matter integration ignores
data/matter/credentials/*
data/matter/**
!data/matter/README.md

# Extra Home Assistant ignores
data/homeassistant/www/media/ha-bambulab/*/prints/*
data/homeassistant/www/media/ha-bambulab/*/timelapse/*
data/homeassistant/backups/*
data/homeassistant/.ha_run.lock
!**/.storage/lovelace.*


# VSCode Web ignores
.openvscode-server
**/.cache/Microsoft/DeveloperTools/deviceid
config/.bash_history

# --- 2026-09-26 hardening (post Pi5→server migration reattach) ---
# Never track HA credential/runtime state even if the .storage allowlist grows
**/.storage/auth
**/.storage/auth_provider.*
**/.storage/core.config_entries
**/.storage/core.config
**/.storage/core.restore_state
**/.storage/core.device_registry
**/.storage/core.entity_registry
**/.storage/mobile_app
**/.storage/person
**/.storage/application_credentials
**/.storage/homekit.*
**/.storage/alexa*
**/.storage/cloud
.cloud/
nest/
.vscode/
.cache/
**/.DS_Store
data/homeassistant/home-assistant.log.fault
data/homeassistant/www/
# ESPHome Device Builder runtime state (peer-link key, pairing, prefs)
data/esphome/.device-builder*
data/esphome/.offloader_pairings.json
data/esphome/.receiver_peers.json
data/esphome/.git.device-builder-*/
data/esphome/.esphome/
# Container-level secrets
secrets/
config/*.env
*.env
**/.storage/http
